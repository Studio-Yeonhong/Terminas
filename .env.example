# Terminas server settings. Copy to .env and fill in.
# Docker: docker-compose.yml reads this file (SHELL_HOST / SHELL_PORT / SHELL_DATA_DIR are set there).

# Production (without Docker): also set NODE_ENV=production. Leave it out for local development.
# NODE_ENV=production

# ---------- Address ----------
# The address people open in the browser (https in production). Cookies, the Origin check and the
# Google redirect URI (<this>/api/auth/google/callback) are derived from it.
SHELL_PUBLIC_URL=http://localhost:5380
SHELL_HOST=127.0.0.1
SHELL_PORT=5381
# 1 only when a reverse proxy / tunnel sits in front on this machine or a private network
# (the client IP then comes from the entry that proxy added to X-Forwarded-For). Or list the proxies' IPs/CIDRs.
SHELL_TRUST_PROXY=0
# Web SSH to private-network addresses around the server: all | admins | none
# (default: all, or admins when SHELL_OPEN_SIGNUP=1)
# SHELL_RELAY_PRIVATE=

# ---------- Sign-in: Google ----------
# OAuth client of type "Web application". Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma separated emails that may sign in with Google without an invite and create teams (server admins).
SHELL_BOOTSTRAP_ADMINS=

# ---------- Sign-in: ID and password ----------
# 1 = show ID/password sign-in. Invited people get a one-time invite code to set their own password.
SHELL_PASSWORD_LOGIN=0
# First server admin, created on start if that account has no password yet (email or 3-64 chars of a-z 0-9 . _ -).
# The password (10+ chars) is used only once; remove it from this file after the first start.
# Forgot it later? node server/scripts/user-password.ts <id>   (npm run user:password -w server -- <id>)
SHELL_ADMIN_ID=
SHELL_ADMIN_PASSWORD=

# ---------- Sign-up and public links ----------
# 1 = anyone may sign up with Google (verified email) without an invite, use their personal vault
# without a team and create teams. 0 (default) = invite-only. There is no self sign-up with ID/password.
# SHELL_OPEN_SIGNUP=0
# Links on the sign-in screen and in Settings -> Account (http/https only, or the server will not start).
# A public server should publish terms of service and a privacy policy.
# SHELL_TERMS_URL=https://terminas.example.com/terms
# SHELL_PRIVACY_URL=https://terminas.example.com/privacy
# The "Source code (AGPL-3.0)" link. Default: the official repository. If you run a modified
# server, point it to your modified source.
# SHELL_SOURCE_URL=https://github.com/Studio-Yeonhong/Terminas

# ---------- Admin console ----------
# A separate admin page (users, teams, server log) served only on this machine. It is not part of the web UI
# or the desktop app, and the public server has no admin API. Open http://127.0.0.1:5282/admin on the server
# (or through an SSH tunnel). Set its password on the server: npm run console:password -w server
# 0 turns the console off. Keep the host on 127.0.0.1 (Docker: see docker-compose.yml).
# SHELL_CONSOLE_PORT=5282
# SHELL_CONSOLE_HOST=127.0.0.1

# ---------- Data ----------
# Database (shell.db), totp.key and updates/ live here. Back up the whole folder.
SHELL_DATA_DIR=data
# Empty = log to the console
SHELL_LOG_FILE=
# Optional: 32-byte base64 key that seals 2FA (TOTP) secrets. Without it, <data>/totp.key is created.
# SHELL_TOTP_KEY=

# ---------- Desktop app downloads ----------
# The "Get the Windows app" link on the web sign-in page. Used when this server has no installer in <data>/updates.
# Default: the official releases page (also used when the value is empty).
# SHELL_APP_DOWNLOAD_URL=https://github.com/Studio-Yeonhong/Terminas/releases/latest

# ---------- Development only ----------
# Sign in with just an email (refused unless SHELL_PUBLIC_URL is localhost and NODE_ENV is not production)
SHELL_DEV_LOGIN=0
# Local test sshd (npm run dev:sshd) - a fake SSH server on 127.0.0.1
TEST_SSHD_PORT=2222
TEST_SSHD_USER=demo
TEST_SSHD_PASSWORD=
TEST_SSHD_OTP=
# Encryption password used by the automated UI tests (any 10+ chars)
TEST_VAULT_PASSWORD=
