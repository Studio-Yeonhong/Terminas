{
  "name": "terminas-desktop",
  "productName": "Terminas",
  "version": "1.0.0-beta.1",
  "license": "AGPL-3.0-only",
  "description": "Terminas desktop app",
  "author": "Studio Yeonhong",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "icon": "node scripts/icon.mjs",
    "dist": "npm run build --prefix ../web && node scripts/icon.mjs && electron-builder --win --x64 --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "aws4fetch": "^1.0.20",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "electron-updater": "^6.8.9",
    "ssh2": "^1.17.0"
  },
  "build": {
    "appId": "studio.yeonhong.terminas",
    "productName": "Terminas",
    "artifactName": "Terminas-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**",
      "build/icon.png",
      "app-config.json",
      "update-keys.json",
      "package.json",
      {
        "from": "../web/dist",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/@lydell/**"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Terminas",
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "language": "1042"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "electronVersion": "44.4.5",
    "detectUpdateChannel": false,
    "publish": [
      {
        "provider": "generic",
        "url": "https://github.com/Studio-Yeonhong/Terminas/releases/latest/download"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  }
}
